{
  "Sql": {
    "ConnectionString": "Server=localhost;Database=TILSOFTAI;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Redis": {
    "Enabled": false
  },
  "Auth": {
    "Issuer": "https://localhost:5001",
    "Audience": "tilsoftai",
    "JwksUrl": "",
    "RoleClaimName": "roles",
    "ClockSkewSeconds": 300,
    "AllowHeaderFallback": true
  },
  "AiRouting": {
    "MicrosoftAgentFrameworkRoutingEnabled": true,
    "UseOfficialMicrosoftAgentFramework": true,
    "Provider": "OpenAiCompatibleLocal",
    "Model": "",
    "FallbackToLegacyPipeline": false,
    "AllowedDomains": [ "model" ],
    "MaxCandidateDomains": 1,
    "MaxCandidateToolsPerDomain": 6,
    "MaxTotalCandidateTools": 6,
    "MaxCandidateTools": 6,
    "ToolCallingRequired": true
  },
  "Answering": {
    "Narration": {
      "Enabled": true,
      "UseAi": true,
      "FallbackOnInvalidOutput": true,
      "MaxRowsForNarration": 20,
      "MaxOutputCharacters": 1200
    }
  },
  "Llm": {
    "Provider": "Null",
    "Endpoint": "",
    "ApiKey": "",
    "Model": "",
    "TimeoutSeconds": 360,
    "Temperature": 0.2,
    "MaxResponseTokens": 1024
  },
  "LocalAi": {
    "BaseUrl": "http://192.168.8.247:6688/v1",
    "ChatCompletionsPath": "/chat/completions",
    "Model": "gemma4:e4b",
    "ApiKeyEnvironmentVariable": "TILSOFTAI_LOCAL_AI_API_KEY",
    "TimeoutSeconds": 120
  },
  "CatalogReload": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RuntimePolicy": {
    "Environment": "dev"
  }
}
