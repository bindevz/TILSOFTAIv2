{
  "schemaVersion": 1,
  "policyType": "certification-execution-trust-policy",
  "policyVersion": "sprint-30",
  "defaults": {
    "minimumTrustTier": "metadata_verified",
    "acceptedVerifierClasses": [ "metadata", "provider", "signature" ],
    "allowedUriPrefixes": [ "artifact://", "https://", "ticket://", "incident://" ],
    "requireProviderProvenanceProofForVerifierClasses": [ "provider", "signature" ]
  },
  "environments": {
    "staging": {
      "minimumTrustTier": "provider_verified",
      "acceptedVerifierClasses": [ "provider", "signature" ],
      "allowedUriPrefixes": [ "artifact://", "https://", "ticket://", "incident://" ],
      "requireProviderProvenanceProofForVerifierClasses": [ "provider", "signature" ]
    },
    "prod-like": {
      "minimumTrustTier": "provider_verified",
      "acceptedVerifierClasses": [ "provider", "signature" ],
      "allowedUriPrefixes": [ "artifact://", "https://", "ticket://", "incident://" ],
      "requireProviderProvenanceProofForVerifierClasses": [ "provider", "signature" ]
    },
    "production": {
      "minimumTrustTier": "signature_verified",
      "acceptedVerifierClasses": [ "signature" ],
      "allowedUriPrefixes": [ "artifact://", "https://", "ticket://", "incident://" ],
      "requireProviderProvenanceProofForVerifierClasses": [ "signature" ]
    }
  }
}
